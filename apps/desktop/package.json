  },
  "dependencies": {
    "@ai-sdk/react": "4.0.96",
    "@openomni/ui": "workspace:*",
    "ai": "7.0.93",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "oxc-transform-react": "^0.148.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
