{
  "name": "@openomni/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "rm -rf dist && electron-vite build",
    "preview": "electron-vite preview",
    "shoot:chat": "bun run scripts/shoot-chat.ts",
    "test": "bun test",
    "lint": "bunx biome check ./src ./test",
