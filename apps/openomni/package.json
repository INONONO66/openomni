{
  "name": "@openomni/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/cli/main.ts start",
    "start": "bun run src/cli/main.ts start",
    "build:npm": "bun run script/build-npm-package.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "lint": "bunx biome check ./src ./test",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@effect/sql-sqlite-bun": "4.0.0-rc.118",
    "@openomni/agent": "workspace:*",
    "@openomni/channels": "workspace:*",
    "@openomni/machines": "workspace:*",
    "@openomni/protocol": "workspace:*",
    "effect": "4.0.0-rc.118",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ai": "^6.0.141"
  }
}
