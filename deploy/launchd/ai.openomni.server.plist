<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NOT IMPLEMENTED — macOS launchd support is future scope. This is a structural skeleton only. -->
<!-- NOTE: launchd does not expand $HOME in plist values; these paths are placeholders only. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.openomni.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/env</string>
		<string>bun</string>
		<string>run</string>
		<string>--cwd</string>
		<string>$HOME/.openomni/app</string>
		<string>apps/openomni/src/index.ts</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>$HOME/.openomni/app</string>
	<key>StandardOutPath</key>
	<string>$HOME/.openomni/logs/server.log</string>
	<key>StandardErrorPath</key>
	<string>$HOME/.openomni/logs/server.err</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OPENOMNI_PROCESS</key>
		<string>server</string>
	</dict>
</dict>
</plist>
