[Unit]
Description=OpenOmni Server
After=network.target
Documentation=https://github.com/openomni/openomni

[Service]
Type=simple
WorkingDirectory=%h/.openomni/app
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun run apps/openomni/src/index.ts
EnvironmentFile=-%h/.openomni/.env
Environment=OPENOMNI_PROCESS=server
Restart=on-failure
RestartSec=5s
StartLimitBurst=3
StartLimitIntervalSec=60s
MemoryMax=2G
TasksMax=500
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openomni

[Install]
WantedBy=default.target
