{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreBinaries": ["lefthook", "mkfifo", "tsc", "turbo"],
  "ignore": ["**/*.bench.ts"],
  "ignoreDependencies": [
    "@biomejs/biome",
    "@commitlint/cli",
    "lefthook",
    "turbo"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "script/**/*.ts",
        "biome.json",
        "lefthook.yml",
        "commitlint.config.*"
      ],
      "project": ["script/**/*.ts", "*.json", "*.jsonc", "*.yml", "*.yaml"]
    },
    "apps/openomni": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/agent": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/channels": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ipc": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["test/typed-facade-fixtures/**"]
    },
    "packages/ledger": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/llm": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/machines": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/placement": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/policy": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/telemetry": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
