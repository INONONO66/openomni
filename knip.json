{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreBinaries": ["lefthook", "mkfifo", "tsc", "turbo"],
  "ignore": ["**/*.bench.ts"],
  "ignoreDependencies": [
    "@biomejs/biome",
    "@commitlint/cli",
    "lefthook",
    "turbo"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "script/**/*.{ts,mjs}",
        "biome.json",
        "lefthook.yml",
        "commitlint.config.*"
      ],
      "project": [
        "script/**/*.{ts,mjs}",
        "*.json",
        "*.jsonc",
        "*.yml",
        "*.yaml"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/main.tsx",
        "electron.vite.config.ts",
        "test/**/*.test.ts",
        "test-e2e/**/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "test-e2e/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/openomni": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts",
        "test/fixtures/*.ts",
        "test/helpers/generation-crash-process.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/agent": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts",
        "test/helpers/cluster-crash-child.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/channels": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/machines": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts",
        "test/helpers/fifo-request.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["test/ipc/typed-facade-fixtures/**"]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
