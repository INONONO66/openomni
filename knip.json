{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreBinaries": ["lefthook", "mkfifo", "tsc", "turbo"],
  "ignore": ["**/*.bench.ts"],
  "ignoreDependencies": [
    "@biomejs/biome",
    "@commitlint/cli",
    "lefthook",
    "turbo"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "script/**/*.ts",
        "biome.json",
        "lefthook.yml",
        "commitlint.config.*"
      ],
      "project": ["script/**/*.ts", "*.json", "*.jsonc", "*.yml", "*.yaml"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/main.tsx",
        "electron.vite.config.ts",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/openomni": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/agent": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/channels": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ipc": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["test/typed-facade-fixtures/**"]
    },
    "packages/ledger": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts",
        "test/helpers/disposition-967-archive-fault.ts",
        "test/helpers/disposition-967-fault.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/llm": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/codemode": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/machines": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/policy": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
