{
  "name": "openomni",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "server": "bun run --cwd apps/server src/index.ts",
    "server:dev": "bun --watch run --cwd apps/server src/index.ts",
    "prepare": "lefthook install",
    "lint": "bun run lint:guards && bun run lint:side-effects && bunx biome check .",
    "lint:guards": "bun run script/lint-guards.ts",
    "lint:side-effects": "bun run script/lint-side-effects.ts",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "generate:models-snapshot": "bun run script/generate-models-snapshot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.4",
    "tinybench": "^6.0.2",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
