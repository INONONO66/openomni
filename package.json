{
  "name": "openomni",
  "version": "0.1.0",
  "description": "Single-Owner Agent OS — one Resident, isolated Workers, one ledger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INONONO66/openomni.git"
  },
  "bin": {
    "openomni": "dist/bin/cli.js"
  },
  "files": [
    "dist/bin",
    "migration"
  ],
  "scripts": {
    "build:dist": "bun run script/build-dist.ts",
    "smoke:dist": "bun run script/smoke-dist.ts",
    "prepack": "bun run build:dist && bun run smoke:dist",
    "release": "bun run build:dist && bun run smoke:dist && bun publish",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "server": "bun run --cwd apps/server src/index.ts",
    "server:dev": "bun --watch run --cwd apps/server src/index.ts",
    "prepare": "lefthook install",
    "lint": "bun run lint:guards && bun run lint:side-effects && bunx ultracite check --formatter-enabled=false .",
    "lint:guards": "bun run script/lint-guards.ts",
    "lint:side-effects": "bun run script/lint-side-effects.ts",
    "lint:tools": "bun run script/lint-tools.ts",
    "lint:fix": "bunx ultracite fix .",
    "format": "bunx biome format --write .",
    "check-types": "turbo run check-types && tsc -p script/tsconfig.json",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "generate:models-snapshot": "bun run script/generate-models-snapshot.ts"
  },
  "dependencies": {
    "opensearch-ai-sdk": "0.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "latest",
    "knip": "6.31.0",
    "lefthook": "^2.1.4",
    "tinybench": "^6.0.2",
    "turbo": "^2.8.1",
    "typescript": "5.9.2",
    "ultracite": "7.8.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
