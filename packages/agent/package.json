{
  "name": "@openomni/agent",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.bench.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "bunx biome check ./src",
    "test": "bun test",
    "bench": "bun run bench/index.ts",
    "test:ci": "bun test --timeout 15000 --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.48",
    "@openomni/protocol": "workspace:*",
    "ai": "^6.0.141",
    "effect": "4.0.0-rc.118",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@effect/sql-sqlite-bun": "4.0.0-rc.118",
    "@types/bun": "latest"
  }
}
