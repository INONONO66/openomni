{
  "name": "@openomni/agent",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "bunx biome check ./src",
    "test": "bun test",
    "bench": "bun run bench/index.ts",
    "test:ci": "bun test --timeout 15000 --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openomni/llm": "workspace:*",
    "@openomni/policy": "workspace:*",
    "@openomni/protocol": "workspace:*",
    "@openomni/session": "workspace:*",
    "@openomni/telemetry": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
