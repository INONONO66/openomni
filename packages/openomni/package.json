{
  "name": "@openomni/openomni",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./messaging": "./src/messaging/index.ts",
    "./projection": "./src/projection/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.contract-test.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "bunx biome check ./src",
    "test": "bun test",
    "bench": "bun run bench/index.ts",
    "test:ci": "bun test --timeout 15000 --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@openomni/agent": "workspace:*",
    "@openomni/policy": "workspace:*",
    "@openomni/protocol": "workspace:*",
    "@openomni/session": "workspace:*",
    "@openomni/telemetry": "workspace:*",
    "croner": "^10.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@openomni/coordinator": "workspace:*",
    "@openomni/ipc": "workspace:*",
    "@types/bun": "latest"
  }
}
