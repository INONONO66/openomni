{
  "name": "@openomni/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system for OpenOmni desktop surfaces: tokens, primitives, window chrome (source-shipped TSX + CSS).",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.showcase.json && tsc -p tsconfig.shoot.json",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "test": "bun test --timeout 15000",
    "showcase:shoot": "bun run showcase/shoot.ts",
    "showcase:shoot-detail": "bun run showcase/shoot-detail.ts",
    "showcase:shoot-inspector": "bun run showcase/shoot-inspector.ts",
    "showcase:shoot-transcript": "bun run showcase/shoot-transcript.ts",
    "showcase:shoot-diff-crop": "bun run showcase/shoot-diff-crop.ts",
    "showcase:probe-transcript-tail": "bun run showcase/probe-transcript-tail.ts",
    "showcase:probe-turn-time": "bun run showcase/probe-turn-time.ts",
    "showcase:probe-search": "bun run showcase/probe-search.ts",
    "showcase:probe-density": "bun run showcase/probe-density.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.39.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "1.62.1",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
