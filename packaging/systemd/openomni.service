[Unit]
Description=OpenOmni Coordinator Daemon
After=network.target
Documentation=https://github.com/openomni/openomni

[Service]
Type=simple
User=%i
WorkingDirectory=%h
ExecStart=/usr/local/bin/bun %h/.openomni/coordinator/main.ts
Restart=on-failure
RestartSec=5s
StartLimitBurst=3
StartLimitIntervalSec=60s

# Resource limits
MemoryMax=2G
TasksMax=500

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openomni

# Environment
Environment=OPENOMNI_LOG_LEVEL=info
Environment=OPENOMNI_PROCESS=coordinator

[Install]
WantedBy=default.target
