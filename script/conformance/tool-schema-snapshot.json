            {
              "type": "string",
              "const": "close"
            },
            {
              "type": "string",
              "const": "lease"
            }
          ]
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["op", "args"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "approval",
