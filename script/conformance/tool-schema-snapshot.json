[
  {
    "name": "sendMessage",
    "description": "Send a message, interrupt, or resume to a session; create a child session; or contact an actor. Returns a handle without waiting for a reply.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "session"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["kind", "id"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "new_session"
                },
                "role": {
                  "type": "string",
                  "enum": ["resident", "worker"]
                },
                "runner": {
                  "type": "string",
                  "minLength": 1
                },
                "parent": {
                  "type": "string",
                  "const": "me"
                }
              },
              "required": ["kind", "role", "runner", "parent"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "actor"
                },
                "actorId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["kind", "actorId"],
              "additionalProperties": false
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["message", "interrupt", "resume"]
        },
        "content": {
          "type": "string"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["to", "type", "content"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "approval",
    "description": "Request or decide Owner approval, then promote a contact or merge an endpoint with that approval. Use op=request|decide|contact_promote|endpoint_merge.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "request"
                },
                "request": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "act": {
                          "type": "string",
                          "const": "contact_promotion"
                        },
                        "actorId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Provisional contact to register."
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991,
                          "description": "How long the Owner has to answer."
                        }
                      },
                      "required": ["act", "actorId", "timeoutMs"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "act": {
                          "type": "string",
                          "const": "endpoint_merge"
                        },
                        "endpointId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Endpoint that would move."
                        },
                        "toActorId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Identity the endpoint would join."
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991,
                          "description": "How long the Owner has to answer."
                        }
                      },
                      "required": [
                        "act",
                        "endpointId",
                        "toActorId",
                        "timeoutMs"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["op", "request"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "decide"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Pending approval request."
                },
                "decision": {
                  "type": "string",
                  "enum": ["approved", "refused"],
                  "description": "The Owner's answer."
                }
              },
              "required": ["op", "approvalId", "decision"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "contact_promote"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Approved request that authorizes this act."
                }
              },
              "required": ["op", "approvalId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "endpoint_merge"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Approved request that authorizes this act."
                }
              },
              "required": ["op", "approvalId"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "provision",
    "description": "Administer people, channels, credentials, and provisioning status. Use op=person_declare|person_remove|channel_declare|channel_enable|channel_disable|secret_rotate|status.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "person_declare"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "manifest": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Person id, person:<slug>."
                        },
                        "displayName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["human", "ai_agent", "service"],
                          "description": "What this Person is."
                        },
                        "trustTier": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "co_owner",
                            "manager",
                            "collaborator",
                            "observer",
                            "assigned_worker"
                          ],
                          "description": "Standing trust tier for every bound endpoint."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "channel": {
                                "type": "string",
                                "minLength": 1
                              },
                              "externalId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "workspace": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": ["channel", "externalId"],
                            "additionalProperties": false
                          },
                          "description": "Platform identities this Person speaks through."
                        }
                      },
                      "required": ["id", "kind", "trustTier", "endpoints"],
                      "additionalProperties": false
                    },
                    "approvalId": {
                      "description": "Approved person_mutation approval, when the guard requires one.",
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "description": "Answer window for a guard-opened approval request (default 24h).",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["manifest"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "person_remove"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "personId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["personId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_declare"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Instance id, channel:<provider>:<slug>."
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "enabled": {
                      "default": true,
                      "type": "boolean"
                    },
                    "settings": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": ["string", "number", "boolean"]
                      }
                    },
                    "credential": {
                      "description": "Plaintext credential payload; sealed into the vault, never stored bare.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["id", "provider"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_enable"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["instanceId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_disable"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["instanceId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "secret_rotate"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "secretId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "credential": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Replacement plaintext payload."
                    }
                  },
                  "required": ["secretId", "credential"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "status"
                },
                "args": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "run_code",
    "description": "Run Python with persistent tenant state, machine handles, parallel, llm, and host tool proxies.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["code", "timeoutMs"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "llm",
    "description": "Ask a sub-model one or more one-shot, stateless questions. Results preserve prompt order.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "One or more complete instructions for stateless sub-model calls."
        }
      },
      "required": ["prompts"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  }
]
