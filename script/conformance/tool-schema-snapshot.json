[
  {
    "name": "delegate",
    "description": "Start durable delegated work. Inline ask waits in this turn; process/channel work returns a handle immediately and its settlement arrives as a message.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "What the recipient must do, stated so it can stand alone."
        },
        "operation": {
          "type": "string",
          "enum": ["notify", "ask", "assign"],
          "description": "notify = send and do not expect a reply; ask = request an answer; assign = commission work."
        },
        "scope": {
          "description": "inline = volatile same-domain child; independent = isolated process.",
          "type": "string",
          "enum": ["inline", "independent"]
        },
        "actorId": {
          "description": "Registered external actor; use instead of scope.",
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "description": "Required for assign and forbidden for ask/notify.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "How long the delegation may remain open."
        }
      },
      "required": ["instruction", "operation", "timeoutMs"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "await_delegation",
    "description": "Re-invoke a durable delegation by id. It returns its settlement when available, or says it is still open until the supplied wait limit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "delegationId": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["delegationId"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "cancel_delegation",
    "description": "Cancel open delegated work by id; cancelling settled work returns the existing settlement.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "delegationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["delegationId"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "converse",
    "description": "Open or close a bounded conversation window, or carve a delegation lease from one. Use op=open|close|lease.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "anyOf": [
            {
              "type": "string",
              "const": "open"
