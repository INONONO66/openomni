[
  {
    "name": "delegate",
    "description": "Start durable delegated work. Inline ask waits in this turn; process/channel work returns a handle immediately and its settlement arrives as a message.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "What the recipient must do, stated so it can stand alone."
        },
        "operation": {
          "type": "string",
          "enum": ["notify", "ask", "assign"],
          "description": "notify = send and do not expect a reply; ask = request an answer; assign = commission work."
        },
        "scope": {
          "description": "inline = volatile same-domain child; independent = isolated process.",
          "type": "string",
          "enum": ["inline", "independent"]
        },
        "actorId": {
          "description": "Registered external actor; use instead of scope.",
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "description": "Required for assign and forbidden for ask/notify.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "How long the delegation may remain open."
        }
      },
      "required": ["instruction", "operation", "timeoutMs"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "await_delegation",
    "description": "Re-invoke a durable delegation by id. It returns its settlement when available, or says it is still open until the supplied wait limit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "delegationId": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["delegationId"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "cancel_delegation",
    "description": "Cancel open delegated work by id; cancelling settled work returns the existing settlement.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "delegationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["delegationId"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "converse",
    "description": "Open or close a bounded conversation window, or carve a delegation lease from one. Use op=open|close|lease.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "open"
                },
                "contactId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Registered actor the window reaches."
                },
                "endpointId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Allocated endpoint of that actor the window is pinned to."
                },
                "timeoutMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "How long the window stays open from now."
                },
                "maxOutbound": {
                  "description": "Outbound message cap inside the window (default 8).",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxInbound": {
                  "description": "Inbound message cap before demotion (default 32).",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["op", "contactId", "endpointId", "timeoutMs"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "close"
                },
                "conversationId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Window to settle."
                }
              },
              "required": ["op", "conversationId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "lease"
                },
                "delegationId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Open delegation that will hold the lease."
                },
                "conversationId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Open conversation whose budget is carved."
                },
                "maxOutbound": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Outbound sends allocated from the window."
                }
              },
              "required": [
                "op",
                "delegationId",
                "conversationId",
                "maxOutbound"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "approval",
    "description": "Request or decide Owner approval, then promote a contact or merge an endpoint with that approval. Use op=request|decide|contact_promote|endpoint_merge.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "request"
                },
                "request": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "act": {
                          "type": "string",
                          "const": "contact_promotion"
                        },
                        "actorId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Provisional contact to register."
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991,
                          "description": "How long the Owner has to answer."
                        }
                      },
                      "required": ["act", "actorId", "timeoutMs"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "act": {
                          "type": "string",
                          "const": "endpoint_merge"
                        },
                        "endpointId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Endpoint that would move."
                        },
                        "toActorId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Identity the endpoint would join."
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991,
                          "description": "How long the Owner has to answer."
                        }
                      },
                      "required": [
                        "act",
                        "endpointId",
                        "toActorId",
                        "timeoutMs"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["op", "request"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "decide"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Pending approval request."
                },
                "decision": {
                  "type": "string",
                  "enum": ["approved", "refused"],
                  "description": "The Owner's answer."
                }
              },
              "required": ["op", "approvalId", "decision"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "contact_promote"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Approved request that authorizes this act."
                }
              },
              "required": ["op", "approvalId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "endpoint_merge"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Approved request that authorizes this act."
                }
              },
              "required": ["op", "approvalId"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "provision",
    "description": "Administer people, channels, credentials, and provisioning status. Use op=person_declare|person_remove|channel_declare|channel_enable|channel_disable|secret_rotate|status.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "person_declare"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "manifest": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Person id, person:<slug>."
                        },
                        "displayName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["human", "ai_agent", "service"],
                          "description": "What this Person is."
                        },
                        "trustTier": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "co_owner",
                            "manager",
                            "collaborator",
                            "observer",
                            "assigned_worker"
                          ],
                          "description": "Standing trust tier for every bound endpoint."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "channel": {
                                "type": "string",
                                "minLength": 1
                              },
                              "externalId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "workspace": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": ["channel", "externalId"],
                            "additionalProperties": false
                          },
                          "description": "Platform identities this Person speaks through."
                        }
                      },
                      "required": ["id", "kind", "trustTier", "endpoints"],
                      "additionalProperties": false
                    },
                    "approvalId": {
                      "description": "Approved person_mutation approval, when the guard requires one.",
                      "type": "string",
                      "minLength": 1
                    },
                    "timeoutMs": {
                      "description": "Answer window for a guard-opened approval request (default 24h).",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["manifest"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "person_remove"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "personId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["personId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_declare"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Instance id, channel:<provider>:<slug>."
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "enabled": {
                      "default": true,
                      "type": "boolean"
                    },
                    "settings": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": ["string", "number", "boolean"]
                      }
                    },
                    "credential": {
                      "description": "Plaintext credential payload; sealed into the vault, never stored bare.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["id", "provider"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_enable"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["instanceId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_disable"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["instanceId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "secret_rotate"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "secretId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "credential": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Replacement plaintext payload."
                    }
                  },
                  "required": ["secretId", "credential"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "status"
                },
                "args": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "run_code",
    "description": "Run Python on the local default kernel host. State persists across cells in _scope; host tools are available through tool.<name>(...).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Python source. Call host tools as tool.<name>(...)."
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "How long the cell may run before it is stopped."
        }
      },
      "required": ["code", "timeoutMs"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "memory",
    "description": "Curate durable memory: add, replace, or remove an entry in the system or owner store. What memory holds is already in your context under # Memory — there is no read. Budgets are hard: when a store is full, curate instead of appending. Writes render from the NEXT session, not this one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["add", "replace", "remove"]
        },
        "store": {
          "type": "string",
          "enum": ["system", "owner"],
          "description": "system = durable operating notes; owner = the Owner's profile."
        },
        "id": {
          "description": "Which entry (replace and remove only).",
          "type": "string",
          "minLength": 1
        },
        "content": {
          "description": "The entry text (add and replace only).",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["action", "store"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "work_items",
    "description": "List or inspect commissioned WorkItems, or complete one with verified evidence-backed judgments. Use op=list|get|complete.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "anyOf": [
            {
              "type": "string",
              "const": "list"
            },
            {
              "type": "string",
              "const": "get"
            },
            {
              "type": "string",
              "const": "complete"
            }
          ]
        },
        "workItemId": {
          "type": "string",
          "minLength": 1
        },
        "judgments": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "criterionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "const": "asserted"
                  }
                },
                "required": ["criterionId", "value"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "criterionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "enum": ["verified", "refuted"]
                  },
                  "checkedPredicate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidenceIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "criterionId",
                  "value",
                  "checkedPredicate",
                  "evidenceIds"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "llm",
    "description": "Ask a sub-model one or more one-shot, stateless questions. Results preserve prompt order.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "One or more complete instructions for stateless sub-model calls."
        }
      },
      "required": ["prompts"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  },
  {
    "name": "artifacts",
    "description": "Write large text under the current session or read it back by artifact id. Use op=write or op=read.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "anyOf": [
            {
              "type": "string",
              "const": "write"
            },
            {
              "type": "string",
              "const": "read"
            }
          ]
        },
        "name": {
          "description": "Write only: a short title for the artifact.",
          "type": "string",
          "minLength": 1
        },
        "content": {
          "description": "Write only: the full text to store.",
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "description": "Read only: the artifact id.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["op"],
      "additionalProperties": false
    },
    "safe": false,
    "placement": "host"
  }
]
