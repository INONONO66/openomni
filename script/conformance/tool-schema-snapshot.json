[
  {
    "name": "read",
    "description": "Read a local path or machineId:/absolute/path. UTF-8 text by default with an optional line window (offset, limit); base64 preserves binary bytes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "description": "First line to return, 1-based.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Maximum number of lines.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "encoding": {
          "default": "utf8",
          "type": "string",
          "enum": ["utf8", "base64"]
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "safe": true
  },
  {
    "name": "write",
    "description": "Create or overwrite one local or machineId:/absolute/path file. Parent directories must exist.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "encoding": {
          "default": "utf8",
          "type": "string",
          "enum": ["utf8", "base64"]
        }
      },
      "required": ["path", "content"],
      "additionalProperties": false
    },
    "safe": false,
    "sequential": true
  },
  {
    "name": "edit",
    "description": "Apply one or more exact literal UTF-8 replacements to a local or machineId:/absolute/path file. Each oldText must match exactly once in the original and edits must not overlap. Read/write composition is not atomic against external writers.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "edits": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "oldText": {
                "type": "string",
                "minLength": 1
              },
              "newText": {
                "type": "string"
              }
            },
            "required": ["oldText", "newText"],
            "additionalProperties": false
          }
        }
      },
      "required": ["path", "edits"],
      "additionalProperties": false
    },
    "safe": false,
    "sequential": true
  },
  {
    "name": "ls",
    "description": "List immediate directory entries at a local path or machineId:/absolute/path, without following symlinks. limit caps the entries returned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "safe": true
  },
  {
    "name": "find",
    "description": "Find files and directories whose path relative to the search root matches a glob (e.g. **/*.ts). path defaults to the current directory; machineId:/absolute/path searches a machine. Symlinks are not followed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "default": ".",
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "safe": true
  },
  {
    "name": "grep",
    "description": "Search UTF-8 file content with a regular expression (literal=true for plain text) at a local path or machineId:/absolute/path. Directories recurse in name order without following symlinks; glob filters file names; context adds surrounding lines; binary files refuse.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "default": ".",
          "type": "string",
          "minLength": 1
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "ignoreCase": {
          "default": false,
          "type": "boolean"
        },
        "literal": {
          "default": false,
          "type": "boolean"
        },
        "context": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "safe": true
  },
  {
    "name": "bash",
    "description": "Run a shell command locally, or on the named machine. Local cwd is the host process cwd; remote cwd is /. Use cd in command to change directory. Remote / must be an offered export. No persistent cwd state.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "description": "Seconds before the local command is killed. Remote commands are bounded by the daemon.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "safe": false,
    "sequential": true
  },
  {
    "name": "eval",
    "description": "Run Python in this session's persistent cell: state survives between calls; machine handles, parallel, completion, and tool.<name>() proxies are in scope. operation.op=run.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "run"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "default": 15,
                  "description": "Seconds before the cell is stopped.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["op", "code"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false
  },
  {
    "name": "monitor",
    "description": "Watch command output in a PTY or an absolute path outside the session. Create a persistent or timed watch, rearm a paused watch, or cancel it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "create"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "command"
                        },
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "filter": {
                          "type": "string"
                        },
                        "persistent": {
                          "type": "boolean",
                          "const": true
                        },
                        "timeout_ms": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["kind", "command"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "path"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "event": {
                          "type": "string",
                          "enum": ["create", "modify"]
                        },
                        "persistent": {
                          "type": "boolean",
                          "const": true
                        },
                        "timeout_ms": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["kind", "path", "event"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["op", "description", "source"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "rearm"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["op", "id"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "cancel"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["op", "id"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false,
    "sequential": true
  },
  {
    "name": "send_message",
    "description": "Send one letter to a session, a new child session, or a contact. Returns a handle without waiting for a reply; the reply arrives in your inbox.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "session"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["kind", "id"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "new_session"
                },
                "role": {
                  "type": "string",
                  "enum": ["resident", "worker"]
                },
                "runner": {
                  "type": "string",
                  "minLength": 1
                },
                "parent": {
                  "type": "string",
                  "const": "me"
                }
              },
              "required": ["kind", "role", "runner", "parent"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "contact"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["kind", "id"],
              "additionalProperties": false
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "kind": {
          "default": "prompt",
          "description": "prompt is the default letter; interrupt and resume steer a running session.",
          "type": "string",
          "enum": ["prompt", "interrupt", "resume"]
        },
        "reply_to": {
          "type": "string",
          "minLength": 1
        },
        "deadline_ms": {
          "description": "Milliseconds from now after which no reply counts as unknown.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["to", "message"],
      "additionalProperties": false
    },
    "safe": false
  },
  {
    "name": "provision",
    "description": "Administer contacts, channels, credentials, and provisioning status. Use op=contact_add|contact_remove|contact_promote|contact_merge|channel_add|channel_enable|channel_disable|secret_rotate|status. contact_promote and contact_merge suspend for Owner consent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "contact_add"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "manifest": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Person id, person:<slug>."
                        },
                        "displayName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["human", "ai_agent", "service"],
                          "description": "What this Person is."
                        },
                        "trustTier": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "co_owner",
                            "manager",
                            "collaborator",
                            "observer",
                            "assigned_worker"
                          ],
                          "description": "Standing trust tier for every bound endpoint."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "channel": {
                                "type": "string",
                                "minLength": 1
                              },
                              "externalId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "workspace": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": ["channel", "externalId"],
                            "additionalProperties": false
                          },
                          "description": "Platform identities this Person speaks through."
                        }
                      },
                      "required": ["id", "kind", "trustTier", "endpoints"],
                      "additionalProperties": false
                    },
                    "timeoutMs": {
                      "description": "Answer window for a guard-opened approval request (default 24h).",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["manifest"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "contact_remove"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "personId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["personId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "contact_promote"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "actorId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["actorId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "contact_merge"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "endpointId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "toActorId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["endpointId", "toActorId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_add"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Instance id, channel:<provider>:<slug>."
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "enabled": {
                      "default": true,
                      "type": "boolean"
                    },
                    "settings": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": ["string", "number", "boolean"]
                      }
                    },
                    "credential": {
                      "description": "Plaintext credential payload; sealed into the vault, never stored bare.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["id", "provider"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_enable"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["instanceId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "channel_disable"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["instanceId"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "secret_rotate"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "secretId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "credential": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Replacement plaintext payload."
                    }
                  },
                  "required": ["secretId", "credential"],
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "status"
                },
                "args": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              },
              "required": ["op", "args"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["operation"],
      "additionalProperties": false
    },
    "safe": false
  },
  {
    "name": "completion",
    "description": "Ask a sub-model one one-shot, stateless question and return its text.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "One complete instruction for a stateless sub-model call."
        }
      },
      "required": ["prompt"],
      "additionalProperties": false
    },
    "safe": false
  }
]
